---
import "../styles/global.css";
import Lightbox from "../components/Lightbox.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Portafolio de Javier Camaño Torres, ingeniero full-stack especializado en Laravel, PHP, React y TypeScript.",
  image = "/img-art1.jpg",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const siteName = "Javier Camaño Torres — Portafolio";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Javier Camaño Torres",
  url: Astro.site?.toString(),
  jobTitle: "Ingeniero Full-Stack",
  knowsAbout: ["Laravel", "PHP", "React", "TypeScript", "Astro"],
  sameAs: [
    "https://github.com/JavDev10",
    "https://www.linkedin.com/in/javier-camano-torres12/",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f0f0f" />
    <meta name="author" content="Javier Camaño Torres" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.webp" />
    <link rel="icon" href="/favicon.webp" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.webp" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <Lightbox />

    <script>
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (revealEls.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -80px 0px" }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
