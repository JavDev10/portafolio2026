import { ThinkingOrb } from 'thinking-orbs';

---

<section id="sobremi" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-8 flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-muted-foreground">
      <span><ThinkingOrb state="searching" size={20} speed={0.65} theme="dark" client:visible /></span>
      <span class="line-draw h-px flex-1 bg-border"></span>
      <span>sOBRE-MÍ-02</span>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr_auto]">
      <div class="border border-border bg-card">
        <div class="flex items-center gap-2 border-b border-border px-4 py-2">
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          <span class="h-2 w-2 rounded-full bg-muted-foreground/40"></span>
          <span class="h-2 w-2 rounded-full bg-muted-foreground/40"></span>
          <span class="ml-auto text-xs uppercase tracking-widest text-muted-foreground">terminal.sys</span>
        </div>
        <pre
          id="terminal-output"
          class="h-80 overflow-hidden whitespace-pre-wrap p-4 text-xs leading-relaxed sm:h-96 sm:text-sm"></pre>
      </div>

      <div class="grid grid-cols-2 gap-px border border-border bg-border">
        {metrics.map((m) => (
          <div class="group flex flex-col justify-between gap-3 bg-card p-4 transition-colors hover:bg-foreground hover:text-background">
            <svg
              viewBox="0 0 24 24"
              class="h-10 w-10 text-accent transition-colors group-hover:text-background"
              fill={m.fill ? "currentColor" : "none"}
              stroke={m.fill ? "none" : "currentColor"}
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={m.icon}
            />
            <div>
              <span class="block text-2xl font-bold sm:text-3xl">{m.value}</span>
              <span class="mt-1 block text-xs uppercase tracking-widest text-muted-foreground transition-colors group-hover:text-background/70">
                {m.label}
              </span>
            </div>
          </div>
        ))}
      </div>

      <div class="flex flex-row gap-px border border-border bg-border lg:w-14 lg:flex-col">
        {socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            target={s.href.startsWith("http") ? "_blank" : undefined}
            rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="flex flex-1 items-center justify-center bg-card p-4 text-muted-foreground transition-colors hover:bg-foreground hover:text-background lg:p-0"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill={s.stroke ? "none" : "currentColor"}
              stroke={s.stroke ? "currentColor" : "none"}
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={s.icon}
            />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const lines = [
    "> cd Javier",
    "> cat sobremi.txt",
    "",
    "Ingeniero en Informática (25), especializado en desarrollo full-stack y automatización de procesos. Construyo con Laravel/PHP y React/TypeScript, integro APIs (WooCommerce, MercadoPago, Flow)",
    "",
    "Automatizo flujos con n8n para reemplazar trabajo manual por sistemas que corren solos.",
    "",
    "> cat skills.md",
    "",
    "# Backend",
    "PHP · Laravel · Python · API REST",
    "",
    "# Frontend",
    "React · TypeScript · JavaScript",
    "",
    "# CMS & Automatización",
    "WordPress · n8n",
    "",
    "# Infraestructura",
    "MySQL · Linux · Docker · Git",
    "",
    "> clear",
  ];

  const el = document.getElementById("terminal-output");
  if (el) {
    let lineIndex = 0;
    let charIndex = 0;
    let buffer = "";

    function typeNext() {
      if (lineIndex >= lines.length) {
        lineIndex = 0;
        charIndex = 0;
        buffer = "";
        setTimeout(typeNext, 1000);
        return;
      }
      const currentLine = lines[lineIndex];
      if (charIndex <= currentLine.length) {
        el!.textContent = buffer + currentLine.slice(0, charIndex);
        el!.scrollTop = el!.scrollHeight;
        charIndex++;
        setTimeout(typeNext, 12);
      } else {
        buffer += currentLine + "\n";
        lineIndex++;
        charIndex = 0;
        setTimeout(typeNext, 600);
      }
    }

    typeNext();
  }
</script>
