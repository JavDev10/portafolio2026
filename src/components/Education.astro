---
import { university, certifications } from "../data/education";
import { ThinkingOrb } from "thinking-orbs";
---

<section id="education" class="overflow-hidden border-b border-border" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="edu-fade mb-10 flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-muted-foreground">
      <span><ThinkingOrb state="searching" size={20} speed={0.65} theme="dark" client:visible /></span>
      <span class="line-draw h-px flex-1 bg-border"></span>
      <span>EDUCACIÓN-06</span>
    </div>

    <h2 class="edu-fade mb-10 text-3xl font-bold tracking-tight sm:text-5xl" style="animation-delay: 0.15s">
      Educación
    </h2>

    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr]">
      <div class="flex flex-col gap-6">
        <div class="edu-fade flex flex-col gap-6 border-2 border-foreground bg-card p-6 sm:p-8" style="animation-delay: 0.25s">
          <div class="flex items-center justify-between">
            <div class="flex h-14 w-14 items-center justify-center rounded-full border-2 border-accent text-accent">
              <svg viewBox="0 0 48 48" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
                <path d="M4 18 L24 8 L44 18 L24 28 Z" />
                <path d="M14 22 V32 Q24 40 34 32 V22" />
                <line x1="44" y1="18" x2="44" y2="30" />
              </svg>
            </div>
            <span class="rounded-full border border-border px-3 py-1 text-xs uppercase tracking-widest text-muted-foreground">
              {university.status}
            </span>
          </div>

          <div>
            <h3 class="text-xl font-bold tracking-tight sm:text-2xl">{university.degree}</h3>
            <p class="mt-1 text-sm text-muted-foreground">{university.institution}</p>
          </div>

          <p class="text-sm text-muted-foreground">{university.description}</p>

          <div class="mt-auto flex items-center gap-2 border-t-2 border-foreground pt-4 text-xs uppercase tracking-widest text-muted-foreground">
            <span class="h-2 w-2 bg-accent"></span>
            <span>Periodo:</span>
            <span class="font-bold text-accent">{university.period}</span>
          </div>
        </div>

        <div class="edu-fade flex flex-col gap-4 border-2 border-foreground bg-card p-6 sm:p-8" style="animation-delay: 0.35s">
          <div class="flex h-14 w-14 items-center justify-center rounded-full border-2 border-accent text-accent">
            <svg viewBox="0 0 48 48" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
              <path d="M6 12 C6 12 15 9 24 13 L24 38 C15 34 6 37 6 37 Z" />
              <path d="M42 12 C42 12 33 9 24 13 L24 38 C33 34 42 37 42 37 Z" />
            </svg>
          </div>

          <div>
            <h3 class="text-lg font-bold tracking-tight">Estudio Autodidacta</h3>
            <p class="mt-2 text-sm text-muted-foreground">
              Siempre estoy en búsqueda de nuevas tecnologías y metodologías para aportar valor, agilizar flujos de
              trabajo y profundizar mis conocimientos.
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <h3 class="edu-fade text-xs uppercase tracking-widest text-muted-foreground" style="animation-delay: 0.25s">
          Certificaciones &amp; Cursos
        </h3>

        <div class="grid gap-6 sm:grid-cols-2">
          {certifications.map((cert, i) => (
            <div
              class="edu-fade group relative border-2 border-foreground bg-background p-5 transition-colors hover:bg-foreground hover:text-background"
              style={`animation-delay: ${0.35 + i * 0.1}s`}
            >
              <div class="mb-5 flex items-start justify-between">

                <span class="text-xs font-bold uppercase tracking-widest text-accent transition-colors group-hover:text-background">
                  {cert.year}
                </span>
              </div>

              <h4 class="text-base font-bold leading-tight">{cert.name}</h4>
              <p class="mt-1 text-xs uppercase tracking-widest text-muted-foreground transition-colors group-hover:text-background/70">
                {cert.issuer}
              </p>

              <a
                class="mt-4 inline-block py-1 text-xs uppercase tracking-widest text-accent transition-colors hover:opacity-70 group-hover:text-background"
                href={cert.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver certificación &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #education {
    opacity: 1;
    transform: none;
    transition: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .edu-fade {
      opacity: 0;
    }
    #education.is-visible .edu-fade {
      animation: edu-fade-up 0.6s ease-out forwards;
    }
  }

  @keyframes edu-fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
