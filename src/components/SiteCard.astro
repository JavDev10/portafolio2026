---
import { Image } from "astro:assets";
import type { Site } from "../data/sites";

interface Props {
  site: Site;
  index: number;
}

const { site, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const isLanding = site.pages.length === 1;
const delay = `${(index % 2) * 0.12}s`;

// Duración del recorrido proporcional al alto de la captura: ~1s por cada
// "pantalla" (viewport 16:10) que queda bajo el pliegue, con un mínimo de 1s.
const VIEWPORT_RATIO = 10 / 16;
const durationFor = (img: { width: number; height: number }) =>
  Math.max(1, img.height / img.width / VIEWPORT_RATIO - 1).toFixed(2) + "s";
---

<article
  class="print-reveal h-full"
  data-reveal
  data-site
  style={`--print-delay: ${delay}`}
>
  <div class="print-in flex h-full flex-col border-2 border-foreground bg-card">
    <div class="flex items-center justify-between bg-foreground px-4 py-2 text-xs uppercase tracking-widest text-background">
      <span>Site_{num}</span>
      <span>{isLanding ? "Landing" : `${String(site.pages.length).padStart(2, "0")} Páginas`}</span>
    </div>

    <div class="flex items-center gap-3 border-b-2 border-foreground px-3 py-2">
      <span class="flex shrink-0 gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 border border-foreground"></span>
        <span class="h-2.5 w-2.5 border border-foreground"></span>
        <span class="h-2.5 w-2.5 bg-accent"></span>
      </span>
      <span class="min-w-0 flex-1 truncate border border-border bg-background px-3 py-1 text-xs text-muted-foreground">
        https://<span class="text-foreground">{site.domain}</span>
      </span>
    </div>

    <div
      class="site-viewport relative aspect-[16/10] cursor-ns-resize overflow-hidden bg-background outline-none"
      style={`--dur: ${durationFor(site.pages[0])}`}
      role="button"
      tabindex="0"
      aria-label={`Recorrer la captura de ${site.title}`}
      data-viewport
    >
      {site.pages.map((page, i) => (
        <Image
          src={page}
          alt={`Captura de ${site.title}${isLanding ? "" : `, página ${i + 1}`}`}
          class="site-shot absolute inset-x-0 top-0 h-auto w-full select-none"
          widths={[640, 1080]}
          sizes="(min-width: 768px) 50vw, 100vw"
          draggable="false"
          hidden={i !== 0}
          data-page={i}
          data-dur={durationFor(page)}
        />
      ))}

      <span class="site-progress pointer-events-none absolute inset-y-0 right-0 w-1 bg-accent" aria-hidden="true"></span>

      <span
        class="site-hint pointer-events-none absolute bottom-3 left-3 flex items-center gap-2 border border-foreground bg-background px-2.5 py-1.5 text-[10px] uppercase tracking-widest"
        aria-hidden="true"
      >
        <span class="text-accent">&darr;</span>
        <span class="hint-hover">Pasa el cursor</span>
        <span class="hint-touch">Toca para recorrer</span>
      </span>
    </div>

    {!isLanding && (
      <div class="flex border-t-2 border-foreground" role="tablist" aria-label={`Páginas de ${site.title}`}>
        {site.pages.map((_, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            class="site-tab flex-1 border-r border-border py-2.5 text-xs tracking-widest text-muted-foreground transition-colors last:border-r-0 hover:text-foreground"
            data-tab={i}
          >
            {String(i + 1).padStart(2, "0")}
          </button>
        ))}
      </div>
    )}

    <div class="flex flex-1 flex-col gap-3 border-t-2 border-foreground p-5">
      <div class="flex items-start justify-between gap-4">
        <h3 class="text-lg font-bold tracking-tight">{site.title}</h3>
        <span class="shrink-0 border border-border px-2 py-1 text-xs uppercase tracking-widest text-muted-foreground">
          {site.category}
        </span>
      </div>

      <a
        href={`https://${site.domain}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-auto inline-flex items-center gap-1 self-start py-1 text-xs uppercase tracking-widest text-accent transition-opacity hover:opacity-70"
      >
        Visitar Sitio <span aria-hidden="true">&nearr;</span>
      </a>
    </div>
  </div>
</article>

<style>
  .site-viewport {
    container-type: size;
  }

  .site-shot {
    transform: translateY(0);
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .site-progress {
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .site-hint {
    transition: opacity 0.3s ease;
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-hover {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  /* Bajar: 100% es el alto de la imagen, 100cqh el alto del viewport. */
  .site-viewport[data-scrolling] .site-shot {
    transform: translateY(calc(-100% + 100cqh));
    transition-duration: var(--dur);
    transition-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
  }

  .site-viewport[data-scrolling] .site-progress {
    transform: scaleY(1);
    transition-duration: var(--dur);
    transition-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
  }

  .site-viewport[data-scrolling] .site-hint {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-viewport:hover .site-shot {
      transform: translateY(calc(-100% + 100cqh));
      transition-duration: var(--dur);
      transition-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }

    .site-viewport:hover .site-progress {
      transform: scaleY(1);
      transition-duration: var(--dur);
      transition-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }

    .site-viewport:hover .site-hint {
      opacity: 0;
    }
  }

  .site-viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .site-tab[aria-selected="true"] {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  /* Sin animación: la captura se recorre con scroll nativo. */
  @media (prefers-reduced-motion: reduce) {
    .site-viewport {
      overflow-y: auto;
      cursor: auto;
    }
    .site-viewport .site-shot,
    .site-viewport:hover .site-shot,
    .site-viewport[data-scrolling] .site-shot {
      position: relative;
      transform: none;
      transition: none;
    }
    .site-progress,
    .site-hint {
      display: none;
    }
  }
</style>

<script>
  const viewports = [...document.querySelectorAll<HTMLElement>("[data-viewport]")];
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");

  function stop(viewport: HTMLElement) {
    viewport.removeAttribute("data-scrolling");
  }

  function toggle(viewport: HTMLElement) {
    const willScroll = !viewport.hasAttribute("data-scrolling");
    viewports.forEach(stop);
    viewport.toggleAttribute("data-scrolling", willScroll);
  }

  viewports.forEach((viewport) => {
    // En dispositivos táctiles el hover no existe: un toque baja, otro toque sube.
    viewport.addEventListener("click", () => {
      if (!canHover.matches) toggle(viewport);
    });
    viewport.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggle(viewport);
      }
    });
    viewport.addEventListener("mouseleave", () => stop(viewport));
    viewport.addEventListener("blur", () => stop(viewport));
  });

  document.querySelectorAll<HTMLElement>("[data-site]").forEach((card) => {
    const viewport = card.querySelector<HTMLElement>("[data-viewport]");
    const shots = [...card.querySelectorAll<HTMLElement>("[data-page]")];
    const tabs = [...card.querySelectorAll<HTMLElement>("[data-tab]")];
    if (!viewport || tabs.length === 0) return;

    tabs.forEach((tab, i) =>
      tab.addEventListener("click", () => {
        stop(viewport);
        shots.forEach((shot, j) => (shot.hidden = j !== i));
        tabs.forEach((t, j) => t.setAttribute("aria-selected", String(j === i)));
        viewport.style.setProperty("--dur", shots[i].dataset.dur ?? "1s");
      })
    );
  });
</script>
