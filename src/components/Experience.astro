---
import { experience } from "../data/experience";
import { ThinkingOrb } from 'thinking-orbs';

---

<section id="experience" class="w-full border-b border-border" data-reveal>
  <div class="w-full px-6 py-20 sm:px-10 lg:px-16">
    <div class="mb-10 flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-muted-foreground">
      <span><ThinkingOrb state="searching" size={20} speed={0.65} theme="dark" client:visible /></span>
      <span class="line-draw h-px flex-1 bg-border"></span>
      <span>EXPERIENCIA-03</span>
    </div>

    <h2 class="mb-10 text-3xl font-bold tracking-tight sm:text-5xl">Experiencia</h2>

    <div class="grid gap-6 lg:grid-cols-3">
      {experience.map((item, i) => (
        <div class="flex flex-col border-2 border-foreground bg-card">
          <div class="flex items-center justify-between bg-foreground px-4 py-2 text-background">
            <span class="text-xs uppercase tracking-widest">Role_{String(i + 1).padStart(2, "0")}.md</span>
            <span class="text-xs uppercase tracking-widest">{item.period}</span>
          </div>

          <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
            <h3 class="text-xl font-bold leading-tight tracking-tight sm:text-2xl">
              {item.role}<br /><span class="text-accent">{item.company}</span>
            </h3>

            <p class="text-sm text-muted-foreground">{item.description}</p>

            <div class="flex items-center gap-2 border-t-2 border-foreground pt-4 text-xs uppercase tracking-widest text-muted-foreground">
              <span class="h-2 w-2 bg-accent"></span>
              <span>Duración:</span>
              <span class="font-bold text-accent">{item.duration}</span>
            </div>

            <div class="mt-auto grid grid-cols-2 gap-[2px] bg-foreground pt-[2px]">
              {item.tags.map((tag) => (
                <div class="break-words bg-background p-3 text-center text-xs font-bold uppercase tracking-widest transition-colors hover:bg-foreground hover:text-background">
                  {tag}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
